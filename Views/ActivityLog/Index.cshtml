
@model IEnumerable<Staybnb.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<h1>Activity Logs</h1>

<p>Review recent activity across the Staybnb platform.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No activity records have been found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Activity ID</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>Date and Time (UTC)</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in Model)
                {
                    <tr>
                        <td>@activity.ActivityLogId</td>
                        <td>
                            @(activity.User?.Email
                                ?? activity.UserId
                                ?? "Unknown")
                        </td>
                        <td>@activity.Action</td>
                        <td>@activity.Details</td>
                        <td>
                            @activity.CreatedAt.ToString(
                                "yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td>
                            @(activity.IpAddress ?? "Not recorded")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
