@model Staybnb.ViewModels.CreateReviewViewModel

@{
    ViewData["Title"] = "Write a Review";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">Write a Review</h2>

                    <p class="text-muted">
                        Share your experience with other Staybnb guests.
                    </p>

                    <hr />

                    <form asp-controller="Review"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="BookingId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Guest rating -->
                        <div class="mb-4">
                            <label asp-for="Rating"
                                   class="form-label fw-bold">
                                Your Rating
                            </label>

                            <select asp-for="Rating"
                                    class="form-select">
                                <option value="0">
                                    Select a rating
                                </option>
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>

                            <span asp-validation-for="Rating"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Optional written comment -->
                        <div class="mb-4">
                            <label asp-for="Comment"
                                   class="form-label fw-bold">
                                Your Comments (Optional)
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="2000"
                                      placeholder="How was your stay?">
                            </textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Form actions -->
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Submit Review
                        </button>

                        <a asp-controller="Booking"
                           asp-action="MyBookings"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
