
@model List<Staybnb.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container py-5">

    <h1>Manage Bookings</h1>

    <p class="text-muted">
        Review booking requests for your properties.
    </p>

    @if (TempData["BookingMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["BookingMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info mt-4">
            You do not have any bookings yet.
        </div>
    }
    else
    {
        <div class="row g-4 mt-2">

            @foreach (var booking in Model)
            {
                <div class="col-md-6">

                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <h5 class="card-title">
                                @(booking.Property?.Title ?? "Property")
                            </h5>

                            <p>
                                <strong>Guest:</strong>
                                @(booking.Guest?.Email ?? "Guest account")
                            </p>

                            <p>
                                <strong>Check-in:</strong>
                                @booking.CheckInDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Check-out:</strong>
                                @booking.CheckOutDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Nights:</strong>
                                @booking.Nights
                            </p>

                            <p>
                                <strong>Price per night:</strong>
                                R @booking.PricePerNight.ToString("N2")
                            </p>

                            <p>
                                <strong>Total:</strong>
                                R @booking.TotalPrice.ToString("N2")
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (booking.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (booking.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @booking.Status
                                    </span>
                                }
                            </p>

                            @if (!string.IsNullOrWhiteSpace(booking.HostComment))
                            {
                                <p>
                                    <strong>Host comment:</strong>
                                    @booking.HostComment
                                </p>
                            }

                            @if (booking.Status == "Pending")
                            {
                                <div class="d-flex gap-2 mt-3">

                                    <form asp-action="ApproveBooking"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.BookingId" />

                                        <button type="submit"
                                                class="btn btn-success">
                                            Approve
                                        </button>
                                    </form>

                                    <form asp-action="RejectBooking"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@booking.BookingId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger">
                                            Reject
                                        </button>
                                    </form>

                                </div>
                            }

                        </div>
                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Host Dashboard
        </a>
    </div>

</div>
