
@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="container py-5">

    <!-- Dashboard heading -->
    <h1 class="fw-bold">Host Dashboard</h1>

    <p class="text-muted">
        Welcome to your Staybnb hosting workspace.
    </p>

    <!-- Dashboard cards -->
    <div class="row g-4 mt-2">

        <!-- My Properties card -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        My Properties
                    </h5>

                    <p class="text-muted">
                        Manage your accommodation listings.
                    </p>

                    <a asp-controller="Host"
                       asp-action="Properties"
                       class="btn btn-primary">
                        <i class="bi bi-house-door me-1"></i>
                        Manage Properties
                    </a>

                </div>
            </div>
        </div>

        <!-- Bookings card -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        Bookings
                    </h5>

                    <p class="text-muted">
                        Review guest booking requests and manage reservations.
                    </p>

                    <!-- Only one Manage Bookings button -->
                    <a asp-controller="Host"
                       asp-action="Bookings"
                       class="btn btn-primary">
                        <i class="bi bi-calendar-check me-1"></i>
                        Manage Bookings
                    </a>

                </div>
            </div>
        </div>

        <!-- Check-in card -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        Check-in
                    </h5>

                    <p class="text-muted">
                        Manage guest check-in requirements and instructions.
                    </p>

                    <a asp-controller="Host"
                       asp-action="CheckIn"
                       class="btn btn-primary">
                        <i class="bi bi-key me-1"></i>
                        Check-in Settings
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>
