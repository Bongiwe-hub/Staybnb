@model Staybnb.ViewModels.PropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Property.Title;
    var property = Model.Property;
}

<div class="container mt-4 mb-5">

    <!-- Property image -->
    @if (!string.IsNullOrWhiteSpace(Model.PropertyImageUrl))
    {
        <img src="@Model.PropertyImageUrl"
             alt="@property.Title"
             class="img-fluid rounded mb-4"
             style="width: 100%; max-height: 450px; object-fit: cover;" />
    }

    <!-- Property information -->
    <h1>@property.Title</h1>

    <p class="text-muted">
        @property.Address
        @if (!string.IsNullOrWhiteSpace(property.City))
        {
            <span>, @property.City</span>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(property.PropertyType))
    {
        <p>
            <strong>Property type:</strong> @property.PropertyType
        </p>
    }

    <p>@property.Description</p>

    <h4 class="mt-3">
        R @Model.Property.PricePerNight.ToString("N2")
        <small class="text-muted">per night</small>
    </h4>

    <!-- Average rating -->
    <hr />

    <h3>Guest Reviews</h3>

    @if (Model.ReviewCount > 0)
    {
        <p>
            <strong>
                @Model.AverageRating.ToString("0.0") / 5
            </strong>
            <span class="text-warning">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.AverageRating))
                    {
                        <span>★</span>
                    }
                    else
                    {
                        <span>☆</span>
                    }
                }
            </span>
            <span class="text-muted">
                (@Model.ReviewCount
                @(Model.ReviewCount == 1 ? "review" : "reviews"))
            </span>
        </p>

        <!-- Display each guest review -->
        @foreach (var review in Model.Reviews)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between flex-wrap">
                        <strong>Guest</strong>

                        <small class="text-muted">
                            @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                    </div>

                    <p class="text-warning mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span>★</span>
                            }
                            else
                            {
                                <span>☆</span>
                            }
                        }
                    </p>

                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mb-0">@review.Comment</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No written comment provided.
                        </p>
                    }

                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">
            This property has no reviews yet. Be the first to share your experience after your stay.
        </p>
    }

    <!-- Booking button -->
    <hr />

    <a asp-controller="Booking"
       asp-action="Create"
       asp-route-propertyId="@property.PropertyId"
       class="btn btn-primary w-100">
        Book This Property
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary w-100 mt-2">
        Back to Properties
    </a>

</div>
